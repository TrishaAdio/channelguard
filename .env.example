# ==========================================================================
# Telegram API credentials -> https://my.telegram.org  (API development tools)
# The userbot logs in as YOUR account. It must be an ADMIN of the channel with
# "Invite users via link" and "Ban users" rights.
# ==========================================================================
API_ID=1234567
API_HASH=your_api_hash_here

# ==========================================================================
# CHANNEL to guard. @username, a numeric id like -1001234567890, or invite link.
# (setup.py lets you pick it from a list.)
# ==========================================================================
CHANNEL=

# ==========================================================================
# OWNER who receives the rotating invite link. @username or numeric user id.
# The userbot must be able to DM this account (username, or shared chat).
# ==========================================================================
OWNER=

# ==========================================================================
# How often to revoke + reissue the invite link and DM it to the owner.
# ==========================================================================
ROTATE_MINUTES=5

# ==========================================================================
# Security sweep: permanently ban all non-admin members on startup and every N
# minutes (catches anyone who joined while offline). 0 = startup-only.
# ==========================================================================
SWEEP_MINUTES=5

# ==========================================================================
# Quick-reply userbot (quickreply.py) — runs on the OWNER account.
# LINK_SOURCE = the guard account (username/id) whose messages carry the link.
#   blank = accept only the exact link published by local guard.py.
# SHORTCUT = the Business quick reply name to keep equal to the link.
# ==========================================================================
LINK_SOURCE=
SHORTCUT=demo
# Send your current Business AWAY message to anyone who DMs the first time. 1/0.
GREET_NEW=1
# Also rewrite the /set greeting post's invite link on each rotation.
#   0 (default) = FREEZE the greeting link (keep a fixed "Join for demo" group);
#                 only the /SHORTCUT quick reply follows the live rotating link.
#   1           = old behaviour: swap the greeting link too.
SWAP_GREETING=0
# Receive guard.py's rotated link and rewrite it into the /SHORTCUT (demo)
# Business quick reply — the original behaviour. 1 (default) = ON. Set 0 to
# freeze the demo link (e.g. if the BOT manages links instead).
USERBOT_RELAY_LINK=1

# Payment upload channel for quickreply.py. Type .setchannel in the target
# channel (or .setchannel <id|@username> from anywhere) to save this
# automatically. Use a numeric id such as -1001234567890.
# This parameter is authoritative: editing it here and restarting moves the
# upload target, and every receipt that has not posted yet follows it.
PAYMENT_CHANNEL=

# ==========================================================================
# Daily payment-screenshot ZIPs (quickreply.py). After each IST day ends, that
# day's proof images are zipped and sent here. Change live with .ssto; turn
# off with .ssauto off (or SS_AUTO=0). Manual: .sszip [today|yesterday|date].
# ==========================================================================
SS_CHANNEL=@ohthatsthepoint
SS_AUTO=1

# ==========================================================================
# DM country separator (quickreply.py). 1 = new DMs from outside India are
# added to the "Videshi" chat folder. Toggle live with .separator on|off.
# ==========================================================================
SEPARATOR=0

# Business quick reply allowed once per chat (quickreply.py). Blank = off.
CATEGORY_SHORTCUT=category
